[Unit]
Description=CSI Arducam ToF depth ROS publisher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mobile-robot
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec /usr/bin/python3 %h/mobile-robot/pi/tof_depth_publisher.py'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
