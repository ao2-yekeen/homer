Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
      Color Scheme: map
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot arrow and URDF footprint
      Enabled: true
      Topic:
        Value: /homer/robot_markers
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Live connection warning
      Enabled: true
      Topic:
        Value: /homer/view_status
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Laser (optional)
      Enabled: false
      Topic:
        Value: /scan
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Name: Diagnostics (optional)
      Enabled: false
      Topic:
        Value: /homer/slam_status
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF (optional)
      Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: URDF model (illustrative joint pose)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: display
      Alpha: 0.7
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down map
      Target Frame: map
      Scale: 70
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 750
