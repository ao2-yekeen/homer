[Unit]
Description=micro-ROS Agent (serial, ESP32 robot)
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/esptool --chip esp32 --port /dev/robot-esp32 --baud 115200 --no-stub --after hard_reset chip_id
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source %h/microros_ws/install/local_setup.bash && exec %h/microros_ws/install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent serial --dev /dev/robot-esp32 -b 921600'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
