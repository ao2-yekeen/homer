[Unit]
Description=micro-ROS Agent (serial, ESP32 robot)
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/test -c %t/mobile-robot-devices/esp32
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source %h/microros_ws/install/local_setup.bash && exec %h/microros_ws/install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent serial --dev %t/mobile-robot-devices/esp32 -b 115200'
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
