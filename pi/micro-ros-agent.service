[Unit]
Description=micro-ROS Agent (serial, ESP32 robot)
After=network.target
Requires=device-discovery.service
After=device-discovery.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -c %t/mobile-robot-devices/esp32
# Reset the ESP32 before opening the agent.  The CP2102's DTR/RTS lines put
# the controller through a clean boot, so its micro-ROS client retries the
# agent handshake after Pi boot or an agent restart.  This writes no firmware.
ExecStartPre=/usr/bin/esptool --chip esp32 --port %t/mobile-robot-devices/esp32 --baud 115200 --no-stub --after hard_reset chip_id
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source %h/microros_ws/install/local_setup.bash && exec %h/microros_ws/install/micro_ros_agent/lib/micro_ros_agent/micro_ros_agent serial --dev %t/mobile-robot-devices/esp32 -b 921600'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
