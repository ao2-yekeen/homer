[Unit]
Description=Arm-only gamepad test (base commands disabled)
After=network.target
Requires=gamepad-joy.service
After=gamepad-joy.service

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 %h/gamepad_teleop.py --ros-args -r /teleop/cmd_vel:=/arm_test/disabled_cmd_vel'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
