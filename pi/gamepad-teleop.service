[Unit]
Description=Direct gamepad teleoperation for base, SO-ARM, and neck
After=network.target
Requires=gamepad-joy.service
After=gamepad-joy.service

[Service]
Type=simple
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec python3 %h/gamepad_teleop.py'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
